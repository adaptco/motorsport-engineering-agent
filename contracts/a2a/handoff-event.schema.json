{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptco.dev/contracts/a2a/handoff-event.schema.json",
  "title": "Agent Handoff Event",
  "type": "object",
  "required": [
    "handoff_id",
    "session_id",
    "trace_id",
    "from_agent",
    "to_agent",
    "reason",
    "checkpoint_ref",
    "created_at"
  ],
  "properties": {
    "handoff_id": { "type": "string" },
    "session_id": { "type": "string" },
    "trace_id": { "type": "string" },
    "from_agent": { "type": "string" },
    "to_agent": { "type": "string" },
    "reason": { "type": "string" },
    "checkpoint_ref": { "type": "string" },
    "memory_refs": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "pending_actions": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axp.local/schemas/workflow-cursor.schema.json",
  "title": "ACP Workflow Cursor",
  "description": "Authoritative resumable workflow state. This replaces transcript-derived position inference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "workflow_id",
    "run_id",
    "session_id",
    "cursor_id",
    "position",
    "current_task_id",
    "current_owner",
    "last_execution_receipt_hash",
    "last_commit_receipt_hash",
    "next_allowed_tasks",
    "checkpoint_id",
    "checkpoint_at",
    "authority_binding",
    "budget_snapshot",
    "protocol_versions"
  ],
  "properties": {
    "kind": {
      "const": "ACP.WorkflowCursor"
    },
    "schema_version": {
      "$ref": "_shared-axp-defs.schema.json#/$defs/Semver"
    },
    "workflow_id": {
      "$ref": "_shared-axp-defs.schema.json#/$defs/WorkflowId"
    },
    "run_id": {
      "$ref": "_shared-axp-defs.schema.json#/$defs/RunId"
    },
    "session_id": {
      "$ref": "_shared-axp-defs.schema.json#/$defs/SessionId"
    },
    "cursor_id": {
      "$ref": "_shared-axp-defs.schema.json#/$defs/Identifier"
    },
    "position": {
      "type": "string",
      "enum": [
        "idle",
        "awaiting_route",
        "awaiting_handoff",
        "running",
        "awaiting_execution_receipt",
        "awaiting_commit_receipt",
        "committed",
        "blocked",
        "failed",
        "closed"
      ]
    },
    "current_task_id": {
      "$ref": "_shared-axp-defs.schema.json#/$defs/TaskId"
    },
    "current_owner": {
      "$ref": "_shared-axp-defs.schema.json#/$defs/Actor"
    },
    "last_execution_receipt_hash": {
      "anyOf": [
        {
          "$ref": "_shared-axp-defs.schema.json#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_commit_receipt_hash": {
      "anyOf": [
        {
          "$ref": "_shared-axp-defs.schema.json#/$defs/Sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_allowed_tasks": {
      "type": "array",
      "items": {
        "$ref": "_shared-axp-defs.schema.json#/$defs/TaskId"
      },
      "uniqueItems": true
    },
    "blocked_tasks": {
      "type": "array",
      "items": {
        "$ref": "_shared-axp-defs.schema.json#/$defs/TaskId"
      },
      "uniqueItems": true
    },
    "checkpoint_id": {
      "$ref": "_shared-axp-defs.schema.json#/$defs/CheckpointId"
    },
    "checkpoint_at": {
      "$ref": "_shared-axp-defs.schema.json#/$defs/Timestamp"
    },
    "budget_snapshot": {
      "$ref": "_shared-axp-defs.schema.json#/$defs/BudgetEnvelope"
    },
    "authority_binding": {
      "$ref": "_shared-axp-defs.schema.json#/$defs/AuthorityBinding"
    },
    "protocol_versions": {
      "$ref": "_shared-axp-defs.schema.json#/$defs/ProtocolVersions"
    },
    "resume_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resume_from_commit_receipt_only",
        "max_resume_depth"
      ],
      "properties": {
        "resume_from_commit_receipt_only": {
          "const": true
        },
        "max_resume_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    }
  }
}

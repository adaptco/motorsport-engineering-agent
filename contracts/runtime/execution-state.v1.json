{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/runtime/execution-state.v1.json",
  "title": "ExecutionState",
  "type": "object",
  "required": ["state_type", "state_version", "run_id", "state_hash"],
  "properties": {
    "state_type": { "type": "string", "const": "execution_state" },
    "state_version": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string" },
    "state_hash": { "type": "string" },
    "prev_state_hash": { "type": ["string", "null"] },
    "checkpoint_seq": { "type": "integer", "minimum": 0 },
    "agent_state": { "type": "object" },
    "memory_refs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}

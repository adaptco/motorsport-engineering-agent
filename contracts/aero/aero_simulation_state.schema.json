        "aero_targets": {
          "type": "object",
          "required": [
            "body_style",
            "active_aero",
            "front_splitter",
            "rear_wing",
            "diffuser",
            "baseline_ride_height_m",
            "baseline_yaw_deg",
            "baseline_pitch_deg"

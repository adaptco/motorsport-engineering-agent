            "solver_status",
            "distro_name",
            "distro_version",
            "openfoam_version",
            "kernel_signature",
            "command",
            "exit_code",
            "started_at",
            "finished_at",
            "stdout_uri",
            "stderr_uri",
            "result_uri",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptco.dev/mea/contracts/aero/aero_simulation_state.schema.json",
  "title": "MEA Aero Simulation Durable State",
  "description": "Durable state for the aerodynamic simulation lane. This record is separate from racing telemetry session state and stores only simulation-specific inputs, geometry branches, solver state, calibration history, and branch outcomes.",
  "type": "object",
  "required": [
    "state_type",
    "state_version",
    "simulation_run_id",
    "project_id",
    "vehicle_program_id",
    "loop_family",
    "loop_layer",
    "lifecycle_state",
    "created_at",
    "updated_at",
    "state_hash",
    "vehicle_snapshot",
    "geometry_state",
    "solver_state",
    "metric_snapshot",
    "provenance",
    "branches",
    "telemetry_links",
    "calibration_state",
    "resume_state"
  ],
  "properties": {
    "state_type": {
      "const": "aero_simulation_state"
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "simulation_run_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "vehicle_program_id": {
      "type": "string",
      "minLength": 1
    },
    "loop_family": {
      "const": "aero"
    },
    "loop_layer": {
      "const": "simulation"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "draft",
        "baseline_built",
        "calibrating",
        "stable",
        "branching",
        "archived"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "state_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "prev_state_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "vehicle_snapshot": {
      "type": "object",
      "required": [
        "identity",
        "dimensions",
        "aero_targets",
        "input_sources",
        "snapshot_notes",
        "case_hint"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "required": [
            "make",
            "model"
          ],
          "properties": {
            "make": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "year": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "trim": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "chassis_code": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "vehicle_class": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "dimensions": {
          "type": "object",
          "required": [
            "length_m",
            "width_m",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptco.dev/contracts/receipts/stage-receipt.schema.json",
  "title": "Stage Receipt",
  "type": "object",
  "required": [
    "receipt_type",
    "schema_version",
    "run_id",
    "created_at",
    "stage",
    "status",
    "state_hash"
  ],
  "properties": {
    "receipt_type": { "type": "string" },
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "stage": { "type": "string" },
    "status": { "type": "string", "enum": ["ok", "warn", "error"] },
    "prev_hash": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      ]
    },
    "state_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "input_digests": { "type": "array", "items": { "type": "string" }, "default": [] },
    "output_digests": { "type": "array", "items": { "type": "string" }, "default": [] },
    "summary": { "type": "object", "default": {} }
  },
  "additionalProperties": false
}

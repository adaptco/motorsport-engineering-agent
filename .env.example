# Control plane
CONTROL_PLANE_PORT=8000
MCP_PORT=7000
DATABASE_URL=postgresql://mea:mea@postgres:5432/mea
REDIS_URL=redis://redis:6379/0
SESSION_LEDGER_DB_PATH=/data/mea-ledger.db
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_ENABLED=true
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_MAX_WAITING=20
QUEUE_ALLOW_IN_MEMORY_FALLBACK=false

# GitHub App
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=12345678
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_ALLOWED_REPOS=your-org/your-repo,another-org/another-repo
GITHUB_API_MAX_RETRIES=2
GITHUB_API_CB_FAILURE_THRESHOLD=3
GITHUB_API_CB_RECOVERY_TIMEOUT_SECONDS=30

# MCP / LLM provider scaffolds
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-...
MCP_SHARED_BEARER_TOKEN=replace-me
MCP_SERVER_BASE_URL=http://localhost:7000
MCP_API_MAX_RETRIES=2
MCP_API_CB_FAILURE_THRESHOLD=3
MCP_API_CB_RECOVERY_TIMEOUT_SECONDS=30

# Worker
MAX_PATCH_LINES=1000
ALLOW_WORKFLOW_CHANGES=false
REDIS_CB_FAILURE_THRESHOLD=3
REDIS_CB_RECOVERY_TIMEOUT_SECONDS=30

# A2A workflow state persistence
A2A_WORKFLOW_STATE_DIR=.mea_tmp/workflow_state
A2A_WORKFLOW_STATE_SCHEMA=contracts/a2a/workflow_state.schema.json
A2A_WORKFLOW_STATE_MAX_HISTORY=50
